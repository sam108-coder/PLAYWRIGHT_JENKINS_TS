{
  "name": "playwright_jenkins_ts",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright TypeScript Automation Framework for Saucedemo with Multi-Env, Excel DDT, Allure Reports, and Jenkins Pipeline",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf allure-results allure-report test-results playwright-report",
    "typecheck": "tsc --noEmit",
    "generate:testdata": "tsx src/testdata/scripts/generateExcelData.ts",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed --project=chromium",
    "test:dev": "cross-env TEST_ENV=dev playwright test --project=chromium",
    "test:qa": "cross-env TEST_ENV=qa playwright test --project=chromium",
    "test:prod": "cross-env TEST_ENV=prod playwright test --project=chromium",
    "test:smoke": "playwright test --project=chromium --grep \"@smoke\"",
    "test:regression": "playwright test --project=chromium --grep \"@regression\"",
    "test:ddt": "playwright test --project=chromium --grep \"@ddt\"",
    "test:e2e": "playwright test --project=chromium --grep \"@e2e\"",
    "test:allure": "npm run clean && playwright test --project=chromium",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report",
    "allure:serve": "allure serve ./allure-results",
    "report:playwright": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "saucedemo",
    "allure-report",
    "ddt",
    "excel",
    "jenkins",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "xlsx": "^0.18.5"
  }
}
